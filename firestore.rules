rules_version = '2';
// Mathra Pipes – Firestore rules.
//
// 1. Replace PUT_ADMIN_UID_HERE with YOUR user UID
//    (Firebase console -> Authentication -> Users -> "User UID").
// 2. Publish (Firestore -> Rules) or run:  firebase deploy --only firestore:rules
//
// Idea: the phone (no login) can only
//    - read prices, settings, its own subscription, the leaderboard
//    - write its own "device" counters, an order REQUEST, and its leaderboard score
// Only YOU (logged in on the admin website) can create / change / remove a
// subscription, mark an order as paid, change prices, ban players.
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PUT_ADMIN_UID_HERE';
    }

    // ── settings + prices (everyone reads, only admin writes) ──────────────
    match /config/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── one document per installed phone (install / open / "viewed plans") ─
    match /devices/{id} {
      allow read, delete: if isAdmin();
      allow create: if id.matches('[0-9A-F]{5}-[0-9A-F]{5}')
          && request.resource.data.keys().hasOnly(
              ['firstSeen', 'lastSeen', 'opens', 'planViews', 'version', 'playerName'])
          && request.resource.data.firstSeen == request.time
          && request.resource.data.lastSeen == request.time
          && request.resource.data.opens == 1
          && request.resource.data.planViews == 0
          && request.resource.data.version is string
          && request.resource.data.version.size() <= 16
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() <= 18;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSeen', 'opens', 'planViews', 'version', 'playerName'])
          && request.resource.data.lastSeen == request.time
          && request.resource.data.opens >= resource.data.opens
          && request.resource.data.opens <= resource.data.opens + 1
          && request.resource.data.planViews >= resource.data.planViews
          && request.resource.data.planViews <= resource.data.planViews + 1
          && request.resource.data.version.size() <= 16
          && request.resource.data.playerName.size() <= 18;
    }

    // ── "I want this plan" requests. The phone can only CREATE one. ────────
    // Document id = DEVICEID_PLANID_YYYYMMDD  (so a phone can't spam).
    // Price and days must match the real plan on the server.
    match /orders/{oid} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(
              ['deviceId', 'planId', 'planName', 'days', 'priceRs',
               'playerName', 'status', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.deviceId.matches('[0-9A-F]{5}-[0-9A-F]{5}')
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() <= 18
          && oid.matches(request.resource.data.deviceId + '_' + request.resource.data.planId + '_[0-9]{8}')
          && exists(/databases/$(db)/documents/plans/$(request.resource.data.planId))
          && get(/databases/$(db)/documents/plans/$(request.resource.data.planId)).data.active == true
          && get(/databases/$(db)/documents/plans/$(request.resource.data.planId)).data.priceRs == request.resource.data.priceRs
          && get(/databases/$(db)/documents/plans/$(request.resource.data.planId)).data.days == request.resource.data.days
        );
    }

    // ── Activation. ONLY the admin website can write here. ─────────────────
    // A phone may read ITS OWN document (it knows its Device ID), never list.
    match /subs/{deviceId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ── Leaderboard ────────────────────────────────────────────────────────
    match /banned/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /players/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if id.matches('[a-z0-9]{10}_[0-9a-f]+')
          && !exists(/databases/$(db)/documents/banned/$(id))
          && request.resource.data.keys().hasOnly(
              ['name', 'score', 'levels', 'bestSeconds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 18
          && request.resource.data.score is int
          && request.resource.data.levels is int
          && request.resource.data.bestSeconds is int
          && request.resource.data.updatedAt is int
          && request.resource.data.score >= 0
          && request.resource.data.levels >= 0
          && request.resource.data.score <= request.resource.data.levels * 1100;
      // A single sync can add at most 1100 points per newly solved level.
      allow update: if !exists(/databases/$(db)/documents/banned/$(id))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'score', 'levels', 'bestSeconds', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 18
          && request.resource.data.score is int
          && request.resource.data.levels is int
          && request.resource.data.bestSeconds is int
          && request.resource.data.updatedAt is int
          && request.resource.data.score >= 0
          && request.resource.data.levels >= 0
          && request.resource.data.score - resource.data.score
              <= (request.resource.data.levels - resource.data.levels) * 1100;
    }

    // ── "Who is #1 right now" ─ used to give the +hints to a NEW leader ────
    // A phone may take the lead only if that player's stored score is really
    // higher than the old leader's stored score.
    match /meta/leader {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['holder', 'name', 'at', 'seq'])
          && request.resource.data.seq == 1
          && request.resource.data.at == request.time
          && exists(/databases/$(db)/documents/players/$(request.resource.data.holder));
      allow update: if request.resource.data.keys().hasOnly(['holder', 'name', 'at', 'seq'])
          && request.resource.data.seq == resource.data.seq + 1
          && request.resource.data.at == request.time
          && request.resource.data.holder != resource.data.holder
          && exists(/databases/$(db)/documents/players/$(request.resource.data.holder))
          && (!exists(/databases/$(db)/documents/players/$(resource.data.holder))
              || get(/databases/$(db)/documents/players/$(request.resource.data.holder)).data.score
                 > get(/databases/$(db)/documents/players/$(resource.data.holder)).data.score);
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
